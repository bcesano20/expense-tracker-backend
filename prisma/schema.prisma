generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT
  CREDIT
  OTHER
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  lastName  String
  email     String     @unique
  password  String
  status    String     @default("active")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  accounts   Account[]
  categories Category[]
}

model Account {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  name      String
  currency  String    @default("USD")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cards     Card[]
  expenses  Expense[]
  incomes   Income[]
  budgets   Budget[]
  wallet    Wallet?   // optional: an account without a wallet does not track its balance
  monthClosings MonthClosing[]
}

// A closed month: its savings are stored and no expense or income of that month can change.
// Only accounts with a wallet can close months.
model MonthClosing {
  id        Int      @id @default(autoincrement())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int
  month     Int      // 1-12
  year      Int
  savings   Decimal  @db.Decimal(12, 2) // incomes - expenses; negative when it was a deficit
  closedAt  DateTime @default(now())

  @@unique([accountId, month, year])
}

// Free money of an account, outside the debit cards (those keep their own Card.balance)
model Wallet {
  id        Int      @id @default(autoincrement())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int      @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Card {
  id            Int       @id @default(autoincrement())
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     Int
  name          String
  bank          String
  type          String    // "credit" or "debit"
  network       String    // "visa", "mastercard", "amex", "discover"
  closeDay      Int?      // day of the month (e.g. 25) — credit cards only
  balance       Decimal?   @db.Decimal(12, 2)   // available funds — debit cards only
  isActive      Boolean   @default(true)  // false once the card is cancelled (history is kept)
  cancelledAt   DateTime?                 // when the card was cancelled
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses      ExpenseCard[]
  installments  Installment[]
}

model Expense {
  id              Int       @id @default(autoincrement())
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId       Int
  description     String
  amount          Decimal  @db.Decimal(12, 2) 
  date            DateTime
  category        Category  @relation(fields: [categoryId], references: [id])
  categoryId      Int
  paymentMethod   PaymentMethod
  billingMonth    Int       // month when it is billed (1-12)
  billingYear     Int       // year when it is billed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  notes           String?   // Some extra description
  walletApplied   Boolean   @default(false) // true once its effect was applied to the wallet; only then is it reverted

  card            ExpenseCard?
  installments    Installment[]
}

model ExpenseCard {
  id        Int     @id @default(autoincrement())
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId Int     @unique
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    Int
}

model Category {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  name      String
  color     String    // hex color, e.g. "#FF5733"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses  Expense[]
  budgets   Budget[]
}

model Installment {
  id                  Int       @id @default(autoincrement())
  expense             Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId           Int
  card                Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId              Int
  installmentNumber   Int       // installment number (1, 2, 3...)
  totalInstallments   Int       // total number of installments
  installmentAmount   Decimal  @db.Decimal(12, 2) 
  paymentMonth        Int       // month when this installment is due
  paymentYear         Int       // year when this installment is due
  isPayed             Boolean   @default(false) // debit installments are born paid; credit ones are paid by the user
  paidAt              DateTime? // when it was paid; null while unpaid and for historical (backfilled) ones
  walletApplied       Boolean   @default(false) // true only if paying it took money from the wallet
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Income {
  id        Int       @id @default(autoincrement())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int
  description String
  amount      Decimal  @db.Decimal(12, 2) 
  source      String    // "salary", "sales", "investment", "other"
  date        DateTime
  walletApplied Boolean @default(false) // true once its effect was applied to the wallet; only then is it reverted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([accountId])
  @@index([date])
}

model Budget {
  id         Int      @id @default(autoincrement())
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  Int
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int
  
  month      Int      // 1-12
  year       Int
  amount     Decimal?   @db.Decimal(12, 2) // For a fix budget value
  minAmount  Decimal?   @db.Decimal(12, 2) // minimum value for a budget range
  maxAmount  Decimal?   @db.Decimal(12, 2) // maximum value for a budget range
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([accountId, categoryId, month, year]) // unique n-upla
  @@index([accountId, categoryId])
  @@index([accountId, year, month])
}
